# このファイルをコピーするだけで動く状態にしてある。
#   cp .env.example .env
#   docker compose up -d --build
#
# .env は git 管理外（.gitignore の .env* パターン）。コミットしないこと。

# --- DB 資格情報 (docker/compose.yml の db サービスと studio の両方が使う) ---
# ここを変えると DB コンテナの初期化とアプリの接続先が同時に変わる。
# ⚠ パスワードに @ : / ? # を使うと DATABASE_URL の組み立てが壊れる（要 URL エンコード）。
POSTGRES_USER=cms
POSTGRES_PASSWORD=cms
POSTGRES_DB=cms

# --- ビルドのメタ情報（通常は .env に書かず、ビルドコマンドで渡す） ---
# どの版を焼いたイメージかを、docker inspect のラベルと /api/version の両方から読めるようにする。
# 「稼働中のコンテナが古くて、修正が入っていない状態を検証してしまう」事故の再発防止。
#   GIT_SHA=$(git rev-parse HEAD) GIT_DIRTY=$(git status --porcelain | wc -l) \
#     docker compose up -d --build
# 空のままなら unknown になる。**「不明」を「一致」と読まないこと。**
GIT_SHA=
GIT_DIRTY=

# --- ホスト側に公開するポート ---
# よく使うポート(3000/3001/5432/8080/8000/5173/6006)を避けて 31xx 帯に寄せている。
# 割り当て: 3101 Studio(Docker) / 3102 Studio(bun run dev) / 3103 受入ハーネス / 3104 Storybook
# 詳細: knowledge/decisions/port-allocation.md
# DB_PORT はホストの bun run dev / bun run migrate から繋ぐときに使う。
DB_PORT=5436
STUDIO_PORT=3101

# --- ホスト側で bun run dev / bun run migrate を動かすときの接続先 ---
# コンテナ内からは localhost が自分自身を指すため使えない。
# コンテナ用の DATABASE_URL は compose 側で postgres://...@db:5432/... と組み立てている。
DATABASE_URL=postgres://cms:cms@localhost:5436/cms

# --- ストレージ (S3互換。未設定ならローカルFSにフォールバック) ---
# R2 / GCS / AWS S3 / MinIO のどれでも同じコードで動く。エンドポイントを明示するだけ。
#   Cloudflare R2 : https://<アカウントID>.r2.cloudflarestorage.com  (S3_REGION=auto)
#   Google GCS    : https://storage.googleapis.com                   (S3_REGION は実在のリージョン)
#   MinIO         : http://minio:9000                                (S3_FORCE_PATH_STYLE=true)
# 🚨 4つ(ENDPOINT/BUCKET/ACCESS_KEY_ID/SECRET_ACCESS_KEY)が揃わなければローカルFSへ落ちる。
#    部分設定で中途半端に動かさないため。
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# R2 は auto。AWS S3 と GCS は実在のリージョンが要る。
S3_REGION=
# MinIO のようにバケットをホスト名でなくパスで表す実装では true。
S3_FORCE_PATH_STYLE=
# 1つのバケットを複数環境で共有するときの接頭辞。空なら従来のキーと完全に同じ（移行不要）。
# 🚨 **一度決めたら変えないこと。変えると既存ファイルが迷子になります。**
#    DB には接頭辞を含まないキーが入っており、読むときにこの値を前に付けて探すため、
#    後から変えると「今までのファイルが全部見つからない」状態になる。
#    （決定: knowledge/decisions/storage-key-prefix-is-fixed.md）
S3_KEY_PREFIX=

# 旧来の書き方（後方互換のために残す）。S3_ENDPOINT があればそちらが優先される。
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ローカルFSフォールバックの保存先。コンテナでは /app/.storage 固定（名前付きボリューム）。
# ホストで bun run dev するときだけ効く。未設定なら .storage。
STORAGE_LOCAL_ROOT=

# --- 表示・ホワイトラベル ---
# 管理画面の既定の言語。Cookie も Accept-Language も無いときに使う。ja / en。不正な値なら ja。
OHMYCMS_DEFAULT_LOCALE=ja
# サービス名。空なら OhMyCMS。ヘッダ・ログイン画面・<title> に出る（lib/settings/service.ts が読む）。
# GUI（全体設定）で保存した値のほうが優先される。ここは初期値。
OHMYCMS_PROJECT_NAME=OhMyCMS
# ロゴのURL。🚨 **この環境変数はまだどこからも読まれていない**（fromEnvironment() に無い）。
# ロゴは GUI（全体設定）の project_logo だけが保存先で、そちらもまだ画面に描いていない。
OHMYCMS_PROJECT_LOGO_URL=

# --- 最初のログイン（初回セットアップ用） ---
# この1つのパスワードだけで管理画面に入れる（Google の設定は不要・メールアドレスは要らない）。
# 入るとオンボーディングが始まり、そこで本来の管理者アカウントを作る。
# 🚨 オンボーディングが終わると、この入口は閉じる（以後は作った管理者でログインする）。
# 🚨 既定値のままだと警告が出る。本番では必ず変更すること。
OHMYCMS_SETUP_PASSWORD=pass132

# --- 旧方式（auth が差し替え中。完了後に削除する） ---
# --- 最初の管理者（初回起動時に1度だけ作られる） ---
# 両方を設定して起動すると、このメール+パスワードで管理画面に入れる（Google の設定は不要）。
# どちらかが空なら何も作らない。既に同じメールのユーザーが居る場合も何もしない（冪等）。
# パスワードは scrypt でハッシュ化して保存される。平文は DB にもログにも残らない。
# 🚨 入れたあとは管理画面からユーザーを追加する運用。この変数を後から変えても既存ユーザーは変わらない。
OHMYCMS_ADMIN_EMAIL=
OHMYCMS_ADMIN_PASSWORD=

# --- 認証 ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# --- 開発用バックドア。本番では絶対に設定しない ---
ALLOW_DEV_LOGIN=
