# --- DB (docker/compose.yml と対応) ---
DATABASE_URL=postgres://cms:cms@localhost:5436/cms

# --- ストレージ (S3互換。未設定ならローカルFSにフォールバック) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- 認証 ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=

# --- 開発用バックドア。本番では絶対に設定しない ---
ALLOW_DEV_LOGIN=
