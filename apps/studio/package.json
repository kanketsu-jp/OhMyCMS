{
  "name": "@ohmycms/studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3102",
    "build": "next build",
    "start": "next start --port 3102",
    "lint": "eslint",
    "migrate": "bun node_modules/knex/bin/cli.js migrate:latest --knexfile lib/db/knexfile.ts",
    "migrate:rollback": "bun node_modules/knex/bin/cli.js migrate:rollback --knexfile lib/db/knexfile.ts",
    "storybook": "storybook dev -p 3104 --exact-port --no-open --no-version-updates --disable-telemetry",
    "storybook:build": "storybook build --disable-telemetry",
    "storybook:check": "node .storybook/check-stories.mjs",
    "verify:s3": "bun run scripts/verify-s3-storage.ts",
    "verify:secrets": "bun run scripts/verify-secret-box.ts",
    "verify:secret-log": "bun run scripts/verify-secret-safe-logging.ts",
    "check:richtext": "bun run scripts/check-richtext-guards.ts",
    "verify:compress": "bun run scripts/verify-compression.ts",
    "migrate:storage": "bun run scripts/migrate-storage.ts",
    "migrate:status": "bun node_modules/knex/bin/cli.js migrate:status --knexfile lib/db/knexfile.ts",
    "verify:labels": "bun run scripts/verify-labels.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1102.0",
    "@base-ui/react": "^1.6.0",
    "@node-saml/node-saml": "^5.1.0",
    "@tiptap/extension-image": "3.30.1",
    "@tiptap/extension-table": "3.30.1",
    "@tiptap/pm": "3.30.1",
    "@tiptap/react": "3.30.1",
    "@tiptap/starter-kit": "3.30.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "jose": "^6.2.8",
    "knex": "^3.3.0",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "nodemailer": "^9.0.5",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.16.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/addon-themes": "^10.5.7",
    "@storybook/nextjs-vite": "^10.5.7",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "storybook": "^10.5.7",
    "tailwindcss": "^4",
    "tsx": "^4.23.5",
    "typescript": "^5",
    "vite": "^8.2.1"
  }
}
